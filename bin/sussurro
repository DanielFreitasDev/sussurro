#!/usr/bin/env bash
# Lançador do Sussurro — usa o ambiente virtual do próprio projeto.
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PY="$ROOT/.venv/bin/python"
if [[ ! -x "$PY" ]]; then
  echo "Ambiente virtual ausente. Rode: $ROOT/install.sh" >&2
  exit 1
fi
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m sussurro "$@"
